# Entity: table

main: kit: entity: table: {

  alias: field: {}

  fields: {
    file: {
      h: "File"
      n: "file"
      r: true
      t: "`$STRING`"
    }
  }

  name: "table"
  op: {
    create: {
      name: "create"
      points: [
        {
          co: {
            id: "POST /v1/extract/tables"
            source: "openapi3"
            version: 2
          }
          g: {
            header: [
              {
                k: "header"
                n: "x_api_key"
                or: "x-api-key"
                r: false
                t: "`$ANY`"
              }
              {
                k: "header"
                n: "x_rapidapi_proxy_secret"
                or: "x-rapidapi-proxy-secret"
                r: false
                t: "`$ANY`"
              }
            ]
          }
          m: "POST"
          o: "/v1/extract/tables"
          rb: {
            fields: [
              {
                binary: true
                media: "application/octet-stream"
                name: "file"
              }
            ]
            kind: "multipart"
            media: "multipart/form-data"
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "extract"
            }
            {
              lit: "tables"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
